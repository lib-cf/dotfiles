#!/bin/zsh

set -euo pipefail

if (( $# != 1 ))
then
    print -u2 "Usage: ${0:t} FILE"
    exit 1
fi

[[ -f "$1" && -r "$1" && -w "$1" ]] || {
    print -u2 "${0:t}: '$1' must be a readable, writable regular file"
    exit 1
}

frontmost=$(osascript -e '
  tell application "System Events"
    name of first application process whose frontmost is true
  end tell
')

xed_status=0

xed -w "$1" || xed_status=$?

osascript -e "tell application \"${frontmost}\" to activate"

(( xed_status == 0 )) || exit "$xed_status"

xattr "$1" |
  grep -E '^com\.apple\.(metadata:kMDLabel_|lastuseddate#)' |
while IFS= read -r attr
do
  xattr -d "$attr" "$1" 2>/dev/null
done || true

attrs=$(xattr "$1" | grep -v '^com\.apple\.provenance$') || true

if [ -n "$attrs" ]
then
  printf 'Extended Attributes:\n\n'
  printf '%s\n' "$attrs" | sed 's/^/  /'
fi
